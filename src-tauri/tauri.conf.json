{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ConvertAnything",
  "version": "1.0.0",
  "identifier": "com.convertanything.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ConvertAnything",
        "width": 1100,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Convert files on your device",
    "longDescription": "Convert images, video, audio, documents and data files locally. Nothing is uploaded.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
